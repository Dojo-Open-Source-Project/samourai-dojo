{
	"name": "samourai-dojo",
	"version": "1.29.3",
	"description": "Backend server for Samourai Wallet",
	"main": "dist/accounts/index.js",
	"type": "module",
	"scripts": {
		"build": "node build.mjs",
		"typecheck": "npm run typecheck:server && npm run typecheck:admin",
		"test": "vitest run",
		"lint": "biome check .",
		"lint:fix": "biome check --write --unsafe .",
		"admin:dev": "cd admin-app && ../node_modules/.bin/vite dev",
		"typecheck:admin": "tsc -p admin-app/tsconfig.json --noEmit",
		"typecheck:server": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Dojo-Open-Source-Project/samourai-dojo.git"
	},
	"author": "Katana Cryptographic Ltd.",
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/Dojo-Open-Source-Project/samourai-dojo",
	"dependencies": {
		"@dojo-tools/auth47": "2.0.1",
		"@dojo-tools/bitcoin-rpc": "1.0.1",
		"@dojo-tools/bitcoinjs-message": "4.0.1",
		"@dojo-tools/electrum-client": "2.0.0",
		"@dojo-tools/next-block-estimator": "1.0.1",
		"@hono/node-server": "2.1.5",
		"async-sema": "3.1.1",
		"bip32": "4.0.0",
		"bitcoinjs-lib": "6.1.7",
		"bs58check": "4.0.0",
		"hono": "4.13.14",
		"lodash.clonedeep": "4.5.0",
		"mariadb": "^3.5.5",
		"quick-lru": "7.3.0",
		"socks": "2.8.10",
		"soroban-client-nodejs": "1.1.0",
		"sql-escaper": "1.5.2",
		"tiny-secp256k1": "2.2.4",
		"undici": "8.12.2",
		"validator": "13.15.35",
		"workerpool": "10.0.3",
		"ws": "8.22.0",
		"zeromq": "6.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.5",
		"@types/lodash.clonedeep": "^4.5.9",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/validator": "^13.15.10",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^6.3.0",
		"esbuild": "^0.28.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-qr-code": "^2.2.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "download"
		}
	}
}
